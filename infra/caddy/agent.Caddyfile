# OpenClaw 实例的接入入口（V2 OC-2；方案第 4.2 节，契约 docs/decisions/2026-10-31-v2-oc1-contract.md 第 1、2.2、8 节）。
# 与管理员入口（Caddyfile）分开的 Caddy：compose 的 agent-gateway 服务（--profile agents）。
#
# - 两个站点：内网入口（私网地址 + TLS，限定来源网段）与外网入口（公网域名 + 双向证书，信任工作台内部 CA）；
# - 默认拒绝：只放行实例接口与运行服务器接口（/runner-api/v1/*，T-0136）的路径，其余一律 404；
# - 先删掉客户端带来的 X-MyWS-* 请求头，再由这里写入入口与客户端证书指纹。API 只在请求直接来自
#   本服务（AGENT_INGRESS_TRUSTED_PROXIES）时采用这两个请求头；
# - 证书来自文件（/certs）：内网可用内部 CA 或 Tailscale 证书，外网用公网证书；
# - IM（OC-3，契约第 8 节）：/im/ws 先由 API 的 /internal/gateway/im-auth 做 forward_auth，再透传到
#   OpenIM 消息网关（OPENIM_MSG_GATEWAY）；/im/api/* 交给 API 检查后转发；/im/obj/m/* 只读，由 API
#   取图。这里不记访问日志：/im/ws 的 IM 令牌在查询参数里。
{
	admin off
	auto_https off
	# 外网入口（:9443）：OpenClaw 外网实例的 MCP 地址是本机隧道 http://127.0.0.1:<端口>/mcp
	# （T-0133：OpenClaw 的 SSRF 防护只放行字面上的回环地址，拦下“解析到 127.0.0.1 的域名”），
	# 请求的 Host 因此是 127.0.0.1，而隧道的 SNI 是外网域名。开了客户端证书时 Caddy 默认要求
	# Host 与 SNI 一致，这里关掉这项检查：这个端口只有下面一个站点，每个连接都必须先通过双向证书，
	# 不存在用一个站点的证书访问另一个站点的问题
	servers :9443 {
		strict_sni_host insecure_off
	}
}

# 容器自己的健康检查（compose 的 healthcheck）：只绑定容器内的回环地址，外部访问不到
http://127.0.0.1:8099 {
	bind 127.0.0.1
	respond "ok" 200
}

(agent_routes) {
	# 请求体上限按路径分别设（外层设了上限，里面再放大也没用：外层的读取器先生效）
	header -Server

	request_header -X-MyWS-Ingress
	request_header -X-MyWS-Client-Cert-SHA256

	@agent path /agent-api/v1/*
	handle @agent {
		request_body {
			max_size 1MB
		}
		reverse_proxy api:8000 {
			header_up X-MyWS-Ingress {args[0]}
			header_up X-MyWS-Client-Cert-SHA256 {http.request.tls.client.fingerprint}
		}
	}

	# MCP：运行环境的 env_files 可以带文件（单个 20 MB，base64 后约 27 MB），整个请求最多 32 MB（T-0137）
	@mcp path /mcp
	handle @mcp {
		request_body {
			max_size 32MB
		}
		reverse_proxy api:8000 {
			header_up X-MyWS-Ingress {args[0]}
			header_up X-MyWS-Client-Cert-SHA256 {http.request.tls.client.fingerprint}
		}
	}

	# 运行服务器（T-0136）：长轮询领指令、回报结果（读文件最多 20 MB）、对账；凭证 mwr_
	@runner path /runner-api/v1/*
	handle @runner {
		request_body {
			max_size 64MB
		}
		reverse_proxy api:8000 {
			header_up X-MyWS-Ingress {args[0]}
			header_up X-MyWS-Client-Cert-SHA256 {http.request.tls.client.fingerprint}
		}
	}

	# IM 消息网关（WebSocket）：令牌与 sendID 在查询参数里，由 API 校验后透传
	@im_ws {
		path /im/ws
		method GET
	}
	handle @im_ws {
		# route 保持书写顺序：先认证（看到的还是 /im/ws），再改写路径、透传到消息网关。
		# 不用 route 时 Caddy 会把 rewrite 排到 forward_auth 前面（实测）
		route {
			forward_auth api:8000 {
				uri /internal/gateway/im-auth
				# 认证请求是普通的 GET：不带 WebSocket 升级的请求头，否则 API 会按 WebSocket 连接处理
				header_up -Connection
				header_up -Upgrade
				header_up -Sec-WebSocket-Key
				header_up -Sec-WebSocket-Version
				header_up -Sec-WebSocket-Extensions
				header_up X-MyWS-Ingress {args[0]}
				header_up X-MyWS-Client-Cert-SHA256 {http.request.tls.client.fingerprint}
			}
			rewrite * /?{query}
			reverse_proxy {$OPENIM_MSG_GATEWAY:openim-server:10001}
		}
	}

	# IM REST：API 检查白名单与用户后转发到 OpenIM（请求体上限 64 KiB，契约第 8 节）
	@im_api {
		path /im/api/*
		method POST
	}
	handle @im_api {
		request_body {
			max_size 64KB
		}
		reverse_proxy api:8000 {
			header_up X-MyWS-Ingress {args[0]}
			header_up X-MyWS-Client-Cert-SHA256 {http.request.tls.client.fingerprint}
		}
	}

	# 工作台发出的图片（只读）
	@im_obj {
		path /im/obj/m/*
		method GET
	}
	handle @im_obj {
		reverse_proxy api:8000 {
			header_up X-MyWS-Ingress {args[0]}
			header_up X-MyWS-Client-Cert-SHA256 {http.request.tls.client.fingerprint}
		}
	}

	handle {
		request_body {
			max_size 1MB
		}
		respond 404
	}
}

# 内网入口也接受外网域名：两种实例并存时，内网实例取图用的地址是 http://<外网域名>:<隧道端口>，
# 经接入包里的本机代理（不带客户端证书）转发到这里，Host 是外网域名、SNI 是内网域名
https://{$AGENT_INTRANET_HOST}:8443, https://{$AGENT_PUBLIC_HOST}:8443 {
	tls /certs/intranet.crt /certs/intranet.key

	@outside not remote_ip {$AGENT_INTRANET_ALLOWED_CIDRS}
	handle @outside {
		respond 404
	}
	import agent_routes intranet
}

# 外网入口：接受任何 Host（外网域名，或外网实例 MCP 用的 127.0.0.1），证书仍是外网域名的；
# 双向证书照常：没有工作台签发的客户端证书，TLS 握手就失败
https://:9443 {
	tls /certs/public.crt /certs/public.key {
		client_auth {
			mode require_and_verify
			trust_pool file /agent-ca/agent-ca.pem
		}
	}
	import agent_routes public
}
