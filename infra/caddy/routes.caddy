# 工作台的路由与安全响应头：Caddyfile（HTTP :8080）与 https.Caddyfile（域名 + 自动 HTTPS）共用，
# 在站点块里 import。改这里两边同时生效。
# SSE（/api/v1/events/stream）不压缩：压缩会攒够一块才发，事件就不能立刻送到浏览器
@compressible not path /api/v1/events/stream
encode @compressible zstd gzip

# 请求体上限：防止超大请求拖垮后端（Webhook 等需要更大限制时单独放宽）
request_body {
	max_size 10MB
}

header {
	X-Content-Type-Options "nosniff"
	X-Frame-Options "DENY"
	Referrer-Policy "strict-origin-when-cross-origin"
	Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	Cross-Origin-Opener-Policy "same-origin"
	Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	-Server
}

# /readyz 只给内网（规范第 6.1 节：internal）；公网请求按不存在处理
@readyz_public {
	path /readyz
	not remote_ip private_ranges
}
handle @readyz_public {
	respond 404
}

# SSE：不缓冲，每个事件立即转发（Sprint 5 契约第 5 节）
@events path /api/v1/events/stream
handle @events {
	reverse_proxy api:8000 {
		flush_interval -1
	}
}

@backend path /api/* /healthz /readyz
handle @backend {
	reverse_proxy api:8000
}

handle {
	reverse_proxy web:8080
}
