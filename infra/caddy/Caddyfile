# 对外入口（docs/DEVELOPMENT_SPEC.md 第 4、9.3 节；路由约定见 docs/decisions/2026-10-29-sprint-0-contracts.md 第 5 节）。
# 开发环境只监听 HTTP :8080；生产环境启用 HTTPS 与 HSTS 的方法见 docs/deployment.md。
{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	# 请求体上限：防止超大请求拖垮后端（Webhook 等需要更大限制时单独放宽）
	request_body {
		max_size 10MB
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# /readyz 只给内网（规范第 6.1 节：internal）；公网请求按不存在处理
	@readyz_public {
		path /readyz
		not remote_ip private_ranges
	}
	handle @readyz_public {
		respond 404
	}

	@backend path /api/* /healthz /readyz
	handle @backend {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:8080
	}
}
