# Development preview only. Do not enable before the acceptance gates in README.md.
RUNTIME_V2_ENABLED=false
RUNTIME_V2_KUBECONFIG=/etc/workspace/runtime-v2/kubeconfig
RUNTIME_V2_JOURNAL=/var/lib/workspace-runtime-v2/commands.sqlite3
RUNTIME_V2_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
RUNTIME_V2_HOST_ID=00000000-0000-0000-0000-000000000002
RUNTIME_V2_NODE_NAME=replace-with-registered-node
# Base ingress origin, NOT a URL ending in /runner-api/v1.
RUNTIME_V2_URL=https://runner-entry.example.invalid
RUNTIME_V2_TOKEN=REPLACE_WITH_THIS_HOST_MWR_TOKEN
# Optional Workspace trust / public-ingress client certificate; absolute paths.
RUNTIME_V2_CA_FILE=
RUNTIME_V2_CERT_FILE=
RUNTIME_V2_KEY_FILE=
