{
  "uid": "workspace-overview",
  "title": "My Workspace",
  "tags": [
    "my-workspace"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "请求速率（按路由）",
      "datasource": {
        "type": "prometheus",
        "uid": "workspace-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "workspace-prometheus"
          },
          "expr": "sum by (route) (rate(workspace_http_requests_total[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "延迟 P50 / P95 / P99",
      "datasource": {
        "type": "prometheus",
        "uid": "workspace-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "workspace-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(workspace_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "P50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "workspace-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(workspace_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "P95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "workspace-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(workspace_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx 占比",
      "datasource": {
        "type": "prometheus",
        "uid": "workspace-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "workspace-prometheus"
          },
          "expr": "(sum(rate(workspace_http_requests_total{status_class=\"5xx\"}[5m])) or vector(0)) / sum(rate(workspace_http_requests_total[5m]))",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "服务在线",
      "datasource": {
        "type": "prometheus",
        "uid": "workspace-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "workspace-prometheus"
          },
          "expr": "up{job=~\"workspace-.*\"}",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "OpenClaw 实例（按状态）",
      "datasource": {
        "type": "prometheus",
        "uid": "workspace-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "workspace-prometheus"
          },
          "expr": "workspace_agent_instances",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "待审批与 IM 回调积压",
      "datasource": {
        "type": "prometheus",
        "uid": "workspace-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "workspace-prometheus"
          },
          "expr": "workspace_ai_pending_approvals",
          "legendFormat": "待审批"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "workspace-prometheus"
          },
          "expr": "sum(workspace_im_inbox_events{status!=\"dead_letter\"})",
          "legendFormat": "回调待处理"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "workspace-prometheus"
          },
          "expr": "workspace_im_inbox_events{status=\"dead_letter\"}",
          "legendFormat": "回调死信"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "取密钥与实例认证失败（每 5 分钟）",
      "datasource": {
        "type": "prometheus",
        "uid": "workspace-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "workspace-prometheus"
          },
          "expr": "sum by (result) (increase(workspace_agent_secret_resolves_total[5m]))",
          "legendFormat": "取密钥 {{result}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "workspace-prometheus"
          },
          "expr": "sum by (ingress) (increase(workspace_agent_auth_failures_total[5m]))",
          "legendFormat": "认证失败 {{ingress}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "MCP 调用、防刷屏暂停与对账补齐（每 5 分钟）",
      "datasource": {
        "type": "prometheus",
        "uid": "workspace-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "workspace-prometheus"
          },
          "expr": "sum by (outcome) (increase(workspace_mcp_tool_calls_total[5m]))",
          "legendFormat": "MCP {{outcome}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "workspace-prometheus"
          },
          "expr": "increase(workspace_im_relay_pauses_total[5m])",
          "legendFormat": "防刷屏暂停"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "workspace-prometheus"
          },
          "expr": "increase(workspace_im_reconcile_filled_messages_total[5m])",
          "legendFormat": "对账补齐的消息"
        }
      ]
    }
  ]
}
