{
  "uid": "workspace-overview",
  "title": "My Workspace",
  "tags": [
    "my-workspace"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "请求速率（按路由）",
      "datasource": {
        "type": "prometheus",
        "uid": "workspace-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "workspace-prometheus"
          },
          "expr": "sum by (route) (rate(workspace_http_requests_total[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "延迟 P50 / P95 / P99",
      "datasource": {
        "type": "prometheus",
        "uid": "workspace-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "workspace-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(workspace_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "P50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "workspace-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(workspace_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "P95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "workspace-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(workspace_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx 占比",
      "datasource": {
        "type": "prometheus",
        "uid": "workspace-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "workspace-prometheus"
          },
          "expr": "(sum(rate(workspace_http_requests_total{status_class=\"5xx\"}[5m])) or vector(0)) / sum(rate(workspace_http_requests_total[5m]))",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "服务在线",
      "datasource": {
        "type": "prometheus",
        "uid": "workspace-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "workspace-prometheus"
          },
          "expr": "up{job=~\"workspace-.*\"}",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ]
}
