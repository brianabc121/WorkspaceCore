diff --git a/internal/msggateway/myws_authz.go b/internal/msggateway/myws_authz.go
new file mode 100644
index 0000000..e5304f5
--- /dev/null
+++ b/internal/msggateway/myws_authz.go
@@ -0,0 +1,29 @@
+// My Workspace patch (not upstream): bind gateway requests to the connected user.
+//
+// Upstream only checks the outer envelope's sendID against the connection; the inner
+// protobuf requests carried their own userID / sendID, so any user could read or send
+// on behalf of another user. See docs/decisions/2026-10-31-v2-oc0-openclaw-openim-verification.md.
+
+package msggateway
+
+import (
+	"github.com/openimsdk/protocol/constant"
+	"github.com/openimsdk/protocol/sdkws"
+	"github.com/openimsdk/tools/errs"
+)
+
+// checkClientMsg rejects messages a client must not send: as another user, as a
+// notification session, or with a notification content type (those skip the
+// before-send webhooks).
+func checkClientMsg(connUserID string, m *sdkws.MsgData) error {
+	if m.SendID != connUserID {
+		return errs.ErrNoPermission.WrapMsg("sendID must be the connected user", "sendID", m.SendID)
+	}
+	if m.SessionType != constant.SingleChatType && m.SessionType != constant.ReadGroupChatType {
+		return errs.ErrNoPermission.WrapMsg("session type not allowed for clients", "sessionType", m.SessionType)
+	}
+	if m.ContentType >= constant.NotificationBegin {
+		return errs.ErrNoPermission.WrapMsg("notification content types are server-only", "contentType", m.ContentType)
+	}
+	return nil
+}
diff --git a/internal/msggateway/myws_authz_test.go b/internal/msggateway/myws_authz_test.go
