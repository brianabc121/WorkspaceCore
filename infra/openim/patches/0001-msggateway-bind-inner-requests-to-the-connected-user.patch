@@ -0,0 +1,31 @@
+// My Workspace patch (not upstream): tests for checkClientMsg.
+
+package msggateway
+
+import (
+	"testing"
+
+	"github.com/openimsdk/protocol/constant"
+	"github.com/openimsdk/protocol/sdkws"
+)
+
+func TestCheckClientMsg(t *testing.T) {
+	cases := []struct {
+		name string
+		msg  *sdkws.MsgData
+		ok   bool
+	}{
+		{"own single text", &sdkws.MsgData{SendID: "oc_a", RecvID: "ws_admin", SessionType: constant.SingleChatType, ContentType: constant.Text}, true},
+		{"own group at-text", &sdkws.MsgData{SendID: "oc_a", GroupID: "g1", SessionType: constant.ReadGroupChatType, ContentType: constant.AtText}, true},
+		{"impersonate admin", &sdkws.MsgData{SendID: "ws_admin", RecvID: "oc_b", SessionType: constant.SingleChatType, ContentType: constant.Text}, false},
+		{"notification session", &sdkws.MsgData{SendID: "oc_a", RecvID: "oc_b", SessionType: constant.NotificationChatType, ContentType: constant.Text}, false},
+		{"legacy write group session", &sdkws.MsgData{SendID: "oc_a", GroupID: "g1", SessionType: constant.WriteGroupChatType, ContentType: constant.Text}, false},
+		{"notification content type", &sdkws.MsgData{SendID: "oc_a", RecvID: "oc_b", SessionType: constant.SingleChatType, ContentType: constant.FriendAddedNotification}, false},
+	}
+	for _, c := range cases {
+		err := checkClientMsg("oc_a", c.msg)
+		if (err == nil) != c.ok {
+			t.Errorf("%s: err=%v, want ok=%v", c.name, err, c.ok)
+		}
+	}
+}
