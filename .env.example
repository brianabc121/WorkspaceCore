# 复制为 .env 后再修改（make setup 会自动复制）。.env 不要提交到 Git。
# 下面所有值都是占位符；生产环境应从 Secret 读取，不要写进 Compose 文件。

APP_ENV=development
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8080

# 数据库与 Redis：主机名 postgres / redis 是 Compose 内的服务名；本机直接运行 API 时改为 localhost
DATABASE_URL=postgresql+asyncpg://workspace:CHANGE_ME@postgres:5432/workspace
REDIS_URL=redis://redis:6379/0

# Sprint 1 起使用（会话与凭证加密），请生成足够长的随机值
SESSION_SECRET=GENERATE_STRONG_RANDOM_SECRET
CREDENTIAL_ENCRYPTION_KEY=GENERATE_32_BYTE_KEY
CORS_ALLOWED_ORIGINS=http://localhost:8080
