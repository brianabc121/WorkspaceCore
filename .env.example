# 运行 make env（make up 会自动运行）生成 .env：CHANGE_ME / GENERATE_… 会被替换成随机值。
# .env 不要提交到 Git。生产环境应从 Secret 读取，不要写进 Compose 文件。

APP_ENV=development
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8080

# 对外入口（Caddy）的 HTTP 端口。默认只绑定本机；只在可信内网里用 HTTP 访问时才改为 0.0.0.0
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# 用域名对外提供 HTTPS（docs/deploy-guide.md 第 5 步）：取消下一行的注释，并填写域名与邮箱；
# PUBLIC_BASE_URL 同时改为 https://<域名>。Caddy 自动申请证书，需要公网能访问 80 与 443 端口
# COMPOSE_FILE=compose.yaml:compose.https.yaml
SITE_DOMAIN=
ACME_EMAIL=

# Compose 中的 PostgreSQL；API / Worker 的连接串由这三项自动拼接
POSTGRES_DB=workspace
POSTGRES_USER=workspace
POSTGRES_PASSWORD=CHANGE_ME

# 只在本机直接运行 API（make dev）时使用；Compose 内不读取这两项
DATABASE_URL=postgresql+asyncpg://workspace:CHANGE_ME@localhost:5432/workspace
REDIS_URL=redis://localhost:6379/0

# 会话：SESSION_SECRET 用于计算 CSRF Token（生产环境必填，至少 32 个字符）
SESSION_SECRET=GENERATE_STRONG_RANDOM_SECRET
# 首次安装凭据：首次打开网页创建管理员时需要填写（make setup-token 查看）
SETUP_TOKEN=GENERATE_SETUP_TOKEN
# 除 PUBLIC_BASE_URL 外的可信来源（逗号分隔）；登录等写请求的 Origin 必须是其中之一。修改 HTTP_PORT 或改用域名时一并修改
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080
# 侧栏“嵌入页”允许嵌入的网站（https://host[:port]，多个用空格分隔）；不用嵌入页就留空
EMBED_ORIGINS=
# 第三方连接凭证与密钥库的加密密钥（64 位十六进制）；丢失后已保存的凭证无法解密，更换按下面的轮换步骤
CREDENTIAL_ENCRYPTION_KEY=GENERATE_32_BYTE_KEY
# 轮换加密密钥时保留的旧密钥（逗号分隔，只用于解密）。平时为空；
# 轮换步骤见 docs/deployment.md“加密密钥轮换”，全部重新加密之后清空
CREDENTIAL_ENCRYPTION_KEYS_PREVIOUS=

# V2 OpenClaw 实例接口（/agent-api、/mcp）：agent-ingress 网络的网段前三段（默认 172.31.250：
# 子网 <值>.0/29，接入入口 agent-gateway 固定在 <值>.2）。和本机其他 Docker 网络冲突时再改
AGENT_INGRESS_NET=
# API 只采用直接来自这些地址（逗号分隔的 IP 或网段）的入口与客户端证书请求头；为空时用 <AGENT_INGRESS_NET>.2
AGENT_INGRESS_TRUSTED_PROXIES=
# 接入包里写给 OpenClaw 的入口地址，例如 https://10.0.0.5（内网）、https://agent.example.com（外网）；
# 没有配置的入口不能生成该网络模式的接入包
AGENT_INTRANET_URL=
AGENT_PUBLIC_URL=
# 外网入口证书由工作台内部 CA 签发时为 true（deploy.sh connect 的“OpenClaw 接入入口”一步自动设置）：
# 接入包附带 CA 证书，OpenClaw 那边不用另外配置
AGENT_PUBLIC_INTERNAL_CA=false
# 外网入口主机名不在公网 DNS 里时（没有域名，用 agent-gateway.myworkspace.internal），OpenClaw 访问工作台用的 IP
AGENT_PUBLIC_ADDRESS=
# 每晚复盘的 OpenClaw 定时任务（知识库，T-0100）：5 段 cron 与 IANA 时区名；改了以后重新生成接入包或重装
AGENT_REFLECTION_CRON=0 22 * * *
AGENT_REFLECTION_TIMEZONE=Asia/Shanghai

# 知识库图片（T-0103，docs/v2/TIMELINE_PLAN.md 第 4 节）：单张图片上限与每个工作空间的总量（MB）。
# 存在哪里（本机 / Cloudflare R2 / 阿里云 OSS，可选一个副本）由每个工作空间的 owner 在网页「设置 → 图片存储」里配置（T-0223）。
FILE_MAX_MB=10
FILE_QUOTA_MB=2048

# V2 IM：OpenIM（独立 Compose：infra/openim/compose.yaml；make openim-build 构建补丁镜像，make agents-up 之后 make openim-up）。
# 下面的密码与口令由 make env 随机生成，禁止使用官方默认值 openIM123
# 部署了 OpenIM 后填上这两项，API 与 Worker 才会连接 OpenIM；留空表示没有部署，IM 接口返回 503。
# 按本仓库的 Compose 部署时分别是 http://openim-server:10002 与 http://garage:3900（im 网络里的地址，不对外）
OPENIM_API_URL=
OPENIM_OBJECT_URL=
# OpenIM 的 share.secret：签发 imAdmin 与用户的 IM 令牌，工作台的接入网关也用它校验 IM 令牌
OPENIM_SECRET=GENERATE_OPENIM_SECRET
# OpenIM 回调地址 http://api:8000/internal/openim/<口令> 里的口令（至少 32 个字符）
OPENIM_CALLBACK_PATH_TOKEN=GENERATE_OPENIM_CALLBACK_PATH_TOKEN
# im 网络的网段前三段（默认 172.31.252：子网 <值>.0/28，openim-server 固定在 <值>.2）。和本机其他 Docker 网络冲突时再改
IM_NET=
# OpenIM 内部组件的密码（只在 OpenIM 的 Compose 里使用）。etcd 与 Kafka 的密码只能是字母和数字
OPENIM_MONGO_ROOT_PASSWORD=GENERATE_OPENIM_MONGO_ROOT_PASSWORD
OPENIM_MONGO_PASSWORD=GENERATE_OPENIM_MONGO_PASSWORD
OPENIM_REDIS_PASSWORD=GENERATE_OPENIM_REDIS_PASSWORD
OPENIM_ETCD_ROOT_PASSWORD=GENERATE_OPENIM_ETCD_ROOT_PASSWORD
OPENIM_ETCD_PASSWORD=GENERATE_OPENIM_ETCD_PASSWORD
OPENIM_KAFKA_PASSWORD=GENERATE_OPENIM_KAFKA_PASSWORD
# 对象存储 Garage：RPC 密钥与 S3 密钥是 64 位十六进制，访问密钥 ID 是 GK 加 24 位十六进制（make env 按格式生成）
OPENIM_GARAGE_RPC_SECRET=GENERATE_OPENIM_GARAGE_RPC_SECRET
OPENIM_GARAGE_ADMIN_TOKEN=GENERATE_OPENIM_GARAGE_ADMIN_TOKEN
OPENIM_S3_ACCESS_KEY=GENERATE_OPENIM_S3_ACCESS_KEY
OPENIM_S3_SECRET_KEY=GENERATE_OPENIM_S3_SECRET_KEY

# 新闻早报（独立 Compose：infra/trendradar/compose.yaml；make up 之后 make trendradar-up，deploy.sh 的可选组件会自动做）。
# 部署了 TrendRadar 后填 http://trendradar-mcp:3333/mcp（news 网络里的地址，不对外），api、worker 才会使用；
# 留空表示没有部署，设置页显示“未部署”。早报的设置（兴趣、推送渠道、大模型 Key 等）都在网页“设置 → 新闻早报”里
TRENDRADAR_MCP_URL=
# TrendRadar 的定时运行（固定每 30 分钟；推送时间以半小时为单位）。只有验收时改成每分钟
TRENDRADAR_CRON=
# 设置页里填的地址（RSS、自建 NewsNow、推送 Webhook）解析到内网时只允许这些主机名（逗号分隔）；一般留空
NEWS_ALLOWED_HOSTS=
# 早报的时区（推送时间、“今天”的日期）：TrendRadar 两个容器与工作台共用；留空为 Asia/Shanghai。
# TrendRadar 的查询服务按容器时区算“今天”，所以只能在部署时设置，改了要重新 make up 与 make trendradar-up
TRENDRADAR_TZ=

# 项目与任务由工作台自己管理（T-0082 移除了 Vikunja，之前的 VIKUNJA_* 变量不再使用）
# 允许工作台访问的内网主机名（逗号分隔）；其余私有 / 内网地址一律拒绝（SSRF 防护）
INTEGRATION_ALLOWED_HOSTS=

# 可选监控（docker compose --profile monitoring up -d，见 docs/deployment.md 第 12 节）。
# 启用后把下面三个地址填上；留空表示没有部署，运维页显示“未部署”
PROMETHEUS_URL=
GRAFANA_URL=
# 浏览器打开的 Grafana 仪表盘（外链），例如 http://localhost:3000/d/workspace-overview/my-workspace
GRAFANA_DASHBOARD_URL=
# Grafana 管理员密码（make env 随机生成）与访问地址；默认只绑定本机
GRAFANA_ADMIN_PASSWORD=GENERATE_GRAFANA_PASSWORD
GRAFANA_PUBLIC_URL=http://localhost:3000
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000
# 访问日志的路径：path 记录实际路径（不含查询串）；route 只记录路由模板，连 ID 等路径参数也不记录
LOG_REQUEST_PATH=path

# 备份（make backup / make restore-verify，见 docs/deployment.md 第 14 节）
# restic 仓库：本地目录只适合测试，不算异地备份；生产请用异地仓库，例如 s3:https://s3.example.com/bucket/workspace
# （S3 的 AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY 只从环境变量读取，不写在这里）
BACKUP_REPOSITORY=./backups/restic
# 仓库密码（make env 随机生成）。丢失就无法恢复：连同本文件一起单独保管（例如密码管理器），不要只放在这台服务器上
BACKUP_PASSWORD=GENERATE_BACKUP_PASSWORD
# 保留策略：最近 7 天每天一份、30 天内每周一份、90 天内每月一份
BACKUP_KEEP_DAILY=7d
BACKUP_KEEP_WEEKLY=30d
BACKUP_KEEP_MONTHLY=90d
# make restore-verify 的临时环境端口（与正在运行的栈分开）
RESTORE_HTTP_PORT=18080
