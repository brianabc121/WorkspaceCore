{
  "name": "@workspace/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "generate:api": "openapi-typescript ../../services/api/openapi.json -o src/services/schema.d.ts",
    "check:api": "npm run generate:api && git diff --exit-code -- src/services/schema.d.ts",
    "test:browser": "node tests/browser-dashboard.cjs",
    "test:browser:sprint3": "node tests/browser-tasks.cjs",
    "test:browser:knowledge-calendar": "node tests/browser-knowledge-calendar.cjs",
    "test:browser:github-search": "node tests/browser-github-search.cjs",
    "test:browser:operations": "node tests/browser-operations.cjs",
    "test:browser:sprint5": "node tests/browser-sprint5.cjs"
  },
  "dependencies": {
    "@tanstack/vue-query": "5.105.0",
    "@vee-validate/zod": "4.15.1",
    "gridstack": "14.0.0",
    "openapi-fetch": "0.17.0",
    "pinia": "3.0.4",
    "vee-validate": "4.15.1",
    "vue": "3.5.44",
    "vue-router": "4.6.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/vue": "8.1.0",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.12.0",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "3.2.7",
    "vue-tsc": "3.3.14"
  }
}
