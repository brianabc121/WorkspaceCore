#!/usr/bin/env node
// OpenClaw exec SecretRef provider（protocolVersion 1）：从 My Workspace 取密钥。只用 Node 标准库。
// 需要环境变量：MYWS_AGENT_API（例如 https://ws.internal/agent-api）、MYWS_INSTANCE_TOKEN；可选 MYWS_CA_FILE、MYWS_CLIENT_CERT / MYWS_CLIENT_KEY。
// id 以 mc_ 开头的是中转站管理里的模型连接（T-0205），发给 /v1/model-credentials/resolve；
// 其他 id 是密钥库（非模型凭据）的授权引用名，发给 /v1/secrets/resolve。两边的结果合并后交给 OpenClaw。
import { readFileSync } from "node:fs";
import http from "node:http";
import https from "node:https";

const MODEL_REF = /^mc_[0-9a-f]{32}$/;
const fail = (msg) => { process.stderr.write(`myworkspace-secret-resolver: ${msg}\n`); process.exit(1); };

function resolve(base, token, path, ids) {
  return new Promise((done) => {
    const url = new URL(base.replace(/\/$/, "") + path);
    const body = JSON.stringify({ ids });
    const opts = { method: "POST", timeout: 4000, headers: { "content-type": "application/json", "content-length": Buffer.byteLength(body), authorization: `Bearer ${token}` } };
    if (url.protocol === "https:") {
      if (process.env.MYWS_CA_FILE) opts.ca = readFileSync(process.env.MYWS_CA_FILE);
      if (process.env.MYWS_CLIENT_CERT) { opts.cert = readFileSync(process.env.MYWS_CLIENT_CERT); opts.key = readFileSync(process.env.MYWS_CLIENT_KEY); }
    } else if (!["127.0.0.1", "localhost", "::1", process.env.MYWS_LOCAL_TUNNEL_HOST].filter(Boolean).includes(url.hostname)) {
      fail("refusing plain http to a non-loopback host");
    }
    const r = (url.protocol === "https:" ? https : http).request(url, opts, (res) => {
      let data = "";
      res.setEncoding("utf8");
      res.on("data", (c) => { data += c; if (data.length > 1048576) fail("response too large"); });
      res.on("end", () => {
        if (res.statusCode !== 200) fail(`workspace returned ${res.statusCode}`);
        let parsed; try { parsed = JSON.parse(data); } catch { fail("invalid response json"); }
        done(parsed);
      });
    });
    r.on("timeout", () => { r.destroy(); fail("timeout"); });
    r.on("error", (e) => fail(e.code || "request failed"));
    r.end(body);
  });
}

let input = "";
process.stdin.setEncoding("utf8");
process.stdin.on("data", (c) => { input += c; if (input.length > 65536) fail("request too large"); });
process.stdin.on("end", async () => {
  let req;
  try { req = JSON.parse(input || "{}"); } catch { fail("invalid request json"); }
  if (req.protocolVersion !== 1) fail("unsupported protocolVersion");
  const ids = Array.isArray(req.ids) ? req.ids.filter((x) => typeof x === "string") : [];
  const base = process.env.MYWS_AGENT_API, token = process.env.MYWS_INSTANCE_TOKEN;
  if (!base || !token) fail("MYWS_AGENT_API / MYWS_INSTANCE_TOKEN not set");
  const models = ids.filter((id) => MODEL_REF.test(id));
  const vault = ids.filter((id) => !MODEL_REF.test(id));
  const parts = await Promise.all([
    vault.length || !models.length ? resolve(base, token, "/v1/secrets/resolve", vault) : { values: {}, errors: {} },
    models.length ? resolve(base, token, "/v1/model-credentials/resolve", models) : { values: {}, errors: {} },
  ]);
  const out = { protocolVersion: 1, values: {} };
  const errors = {};
  for (const parsed of parts) {
    Object.assign(out.values, parsed.values || {});
    for (const [k, v] of Object.entries(parsed.errors || {})) errors[k] = { code: typeof v === "string" ? v : v.code };
  }
  if (Object.keys(errors).length) out.errors = errors;
  process.stdout.write(JSON.stringify(out));
});
